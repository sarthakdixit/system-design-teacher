# =============================================================================
# System Design Teacher Platform — frontend environment template
# =============================================================================
# Copy this file to frontend/.env.local and fill in values.
# Vite exposes ONLY variables prefixed with VITE_ to the browser.
# Never put secrets here — these end up in the production JS bundle.

# -----------------------------------------------------------------------------
# Backend API base URL.
#   Local dev (default):  http://localhost:8000
#   Azure production:     https://<function-app-name>.azurewebsites.net
#                         (or your custom domain)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Auth mode.
#   "mock" — bypass MSAL, use a hardcoded fake user. Local dev only.
#            Backend's MockAuthProvider must match (ENVIRONMENT=local).
#   "msal" — real Microsoft Entra ID flow via MSAL.js. Required in production.
# -----------------------------------------------------------------------------
VITE_AUTH_MODE=mock

# -----------------------------------------------------------------------------
# Microsoft Entra ID app registration.
#   Local: any value works in mock mode; the placeholders below are fine.
#   Azure: take these from your Entra app registration → Overview pane.
#     - VITE_MICROSOFT_CLIENT_ID = "Application (client) ID"
#     - VITE_MICROSOFT_TENANT_ID = your tenant ID, OR "common" for multi-tenant
#   The frontend client ID MUST match the backend's MICROSOFT_CLIENT_ID
#   (set via Key Vault). They identify the same Entra app.
# -----------------------------------------------------------------------------
VITE_MICROSOFT_CLIENT_ID=dev-placeholder
VITE_MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Setting these in Azure Static Web Apps:
#   Portal → your Static Web App → Configuration → Application settings.
#   Add each VITE_* variable as a build-time environment variable.
#   They are baked into the JS bundle at build time, not at runtime.
# -----------------------------------------------------------------------------