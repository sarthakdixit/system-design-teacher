# =============================================================================
# Environment template for the System Design Teacher backend.
#
# Usage:
#   cp backend/.env.example backend/.env.local
#   # then fill in OPENAI_API_KEY when you're ready to run real LLM flows.
#
# Files named .env*, except this one, are gitignored. Never commit real secrets.
#
# Note on hostnames:
#   - When running ON YOUR HOST (e.g., pytest, seed scripts):
#       MONGO_URI=mongodb://localhost:27018       # Mongo is on host port 27018
#       REDIS_URL=redis://localhost:6379
#   - When running INSIDE docker compose, compose overrides these to use the
#     service hostnames `mongo` and `redis` automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# OpenAI (LLM provider)
#
# - Leave OPENAI_API_KEY as the placeholder during early development —
#   the app auto-selects the StubLLMProvider so all endpoints work without
#   spending tokens.
# - Set a real key when you want to run the seed scripts (Batch 3) or use
#   real AI feedback (Batch 4 — design canvas submissions).
#
# LLM_PROVIDER (optional override):
#   leave unset → auto-detect (real key → openai, placeholder → stub)
#   set to 'openai' → force real OpenAI (requires real key)
#   set to 'stub'   → force stub (skip real LLM calls even if key is present)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY
# LLM_PROVIDER=

# -----------------------------------------------------------------------------
# MongoDB — primary data store. Maps to Cosmos DB (MongoDB API) in production.
# Note the host port is 27018 (the container exposes it remapped to avoid
# conflict with a locally-installed MongoDB on the standard port 27017).
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=sdt

# -----------------------------------------------------------------------------
# Redis — cache + rate limiter. Removed in production (Cosmos handles both).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT — used for session tokens. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET=dev-only-do-not-use-in-prod-replace-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Microsoft Entra ID — frontend uses MSAL.js, backend validates the issued JWT.
# Mock auth ignores these. Real values needed in Batch 5.
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=dev-placeholder
MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Azure-only (unset locally). Populated from Key Vault in production.
# -----------------------------------------------------------------------------
# APPINSIGHTS_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# Rate limits (per user, per UTC day). See ADR-004.
# -----------------------------------------------------------------------------
RATE_LIMIT_SITUATION_DAILY=5
RATE_LIMIT_DESIGN_DAILY=2

# -----------------------------------------------------------------------------
# Global wallet caps (across ALL users, per UTC day). Hard ceiling on LLM cost.
# -----------------------------------------------------------------------------
GLOBAL_CAP_SITUATION_DAILY=50
GLOBAL_CAP_DESIGN_DAILY=100

# -----------------------------------------------------------------------------
# Design feedback cache TTL (days). After this, identical-diagram submissions
# pay for fresh LLM feedback again. MongoDB TTL index sweeps expired entries.
# 30 days is a defensible default — long enough that cache hit rates are
# meaningful, short enough that prompt or model changes propagate within a month.
# -----------------------------------------------------------------------------
FEEDBACK_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# CORS — frontend dev server origin. Comma-separated list.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO