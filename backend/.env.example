# =============================================================================
# System Design Teacher Platform — backend environment template
# =============================================================================
# Copy this file to backend/.env.local and fill in your actual values.
# Never commit .env.local — it's gitignored.
#
# Variables are grouped by environment:
#   - "Both": needed locally AND in Azure
#   - "Local only": only matters when ENVIRONMENT=local
#   - "Azure only": only set in production (typically via Function App settings,
#                   never in a real .env file outside dev)

# -----------------------------------------------------------------------------
# Both — Environment selector. Drives DI container branch.
#   "local"  → MongoDB Docker, mock auth, console telemetry, in-memory cache
#   "azure"  → Cosmos DB, Microsoft Entra ID, Application Insights, Key Vault
# -----------------------------------------------------------------------------
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Both — Database connection.
#   Local Docker Compose maps host port 27018 → container port 27017.
#   When the backend runs INSIDE Docker, use the service name `mongo` on 27017.
#   When running scripts on the host (seed scripts), use localhost:27018.
#   In Azure, this is overridden by the Key Vault secret MONGO-URI (Cosmos
#   connection string with ?ssl=true&...).
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=sdt

# -----------------------------------------------------------------------------
# Local only — Redis connection. Used as in-process cache backing.
#   Azure deployment uses MemoryRateLimiter and the database-level feedback
#   cache; Redis is not deployed in Azure free tier.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Both — OpenAI. In Azure, override via Key Vault secret OPENAI-API-KEY.
#   LLM_PROVIDER selects: "auto" picks based on key validity, "openai" forces
#   real calls (will fail without a valid key), "stub" uses the StubLLMProvider
#   (useful for tests or rate-limit demos without spending money).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder
LLM_PROVIDER=auto

# -----------------------------------------------------------------------------
# Both — JWT signing. In Azure, override via Key Vault secret JWT-SECRET.
#   Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Both — Microsoft Entra ID app registration.
#   Local mock auth ignores these.
#   In Azure, override via Key Vault secrets MICROSOFT-CLIENT-ID and
#   MICROSOFT-TENANT-ID. For multi-tenant: tenant_id="common".
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=dev-client-id
MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Both — Rate limiting. Per user (daily) and global (daily). UTC midnight reset.
# -----------------------------------------------------------------------------
RATE_LIMIT_SITUATION_DAILY=5
RATE_LIMIT_DESIGN_DAILY=2
GLOBAL_CAP_SITUATION_DAILY=50
GLOBAL_CAP_DESIGN_DAILY=100

# -----------------------------------------------------------------------------
# Both — Feedback cache TTL. How long a design-feedback cache entry lives
#   before MongoDB's TTL index deletes it. 30 days is the recommended default.
#   Lower this if you change the design_feedback.md prompt frequently.
# -----------------------------------------------------------------------------
FEEDBACK_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Both — CORS allowlist (comma-separated origins).
#   Local: include the Vite dev server.
#   Azure: include your Static Web App URL, e.g.
#     ["https://<name>.azurestaticapps.net"]
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Azure only — Key Vault URL. Required when ENVIRONMENT=azure.
#   Format: https://<vault-name>.vault.azure.net/
#   The Function App's Managed Identity must have role
#   "Key Vault Secrets User" on this vault.
#   When set, the app loads OPENAI_API_KEY, JWT_SECRET, MONGO_URI,
#   MICROSOFT_CLIENT_ID, MICROSOFT_TENANT_ID from Key Vault at startup,
#   overriding any values set above.
# -----------------------------------------------------------------------------
AZURE_KEYVAULT_URL=

# -----------------------------------------------------------------------------
# Azure only — Application Insights connection string.
#   Required when ENVIRONMENT=azure.
#   Found in the App Insights resource → Overview → Connection String.
#   Format: InstrumentationKey=...;IngestionEndpoint=https://...
# -----------------------------------------------------------------------------
APPINSIGHTS_CONNECTION_STRING=